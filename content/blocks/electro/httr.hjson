#=====================================================================================================#
# httr - Газоохлаждаемый ядерный реактор (библиотека MultiCrafter, JojoFR1/MultiCrafter, имя multicrafter).
#
# Прообраз - реальные высокотемпературные реакторы с гелиевым охлаждением: торий и графит как топливо
# и замедлитель, гелий как теплоноситель. Во втором режиме тепло реактора разлагает воду на водород
# и кислород (в игре - озон), как в исследованиях японского реактора HTTR.
#
# Режимы (в секунду):
#   Энергия:            торий 1, графит 1, гелий 40, энергия 300 -> энергия 6000, шлак 10
#   Энергия и водород:  то же + вода 200                     -> энергия 5000, шлак 10, водород 120, озон 80
#
# Вода делится как у ванильного электролизёра (10 воды -> 6 водорода + 4 озона): 200 -> 120 + 80.
# Второй режим теряет 1000 энергии против первого, а 20 электролизёров на те же 120 водорода
# потребляют 1200: тепло реактора разлагает воду выгоднее, чем электричество.
#
# Единицы в рецептах:
#   items   - за цикл; craftTime 60 тиков = 1 секунда
#   liquids - за тик (в секунду / 60)
#   power   - за тик (в секунду / 60)
#
# Взрыв (scripts/httr.js): если разогретому реактору не хватает гелия, если некуда сливать шлак
# или если некуда девать водород.
#=====================================================================================================#

type: MultiCrafter

size: 3
health: 1400
itemCapacity: 20
# Общий объём для каждой жидкости: гелия хватит на 12 с, воды на 2,4 с,
# водород забьётся за 4 с, озон за 6 с, шлак за 48 с.
liquidCapacity: 480

# Шлак выходит по стрелке (её игра рисует сама при установке), водород - с противоположной стороны,
# озон - справа от стрелки. Стороны: 0 - вперёд по стрелке, 1 - слева, 2 - назад, 3 - справа, -1 - все.
# Номер стороны берётся по порядку жидкостей в output.liquids рецепта, поэтому шлак в обоих рецептах первый.
# Водороду и озону не дано -1 (все стороны): пустая труба шлака приняла бы любую жидкость,
# и шлак мог бы забиться, а это взрыв.
# Гелий, воду и предметы можно подавать с любой стороны.
rotate: true
liquidOutputDirections: [0, 2, 3]

jsonRecipes: [
    {
        name: httr-power
        localizedName: "Energy"
        craftTime: 60
        input: {
            items: ["thorium/1", "graphite/1"]
            liquids: ["helium/0.666667"]
            power: 5
        }
        output: {
            liquids: ["slag/0.166667"]
            power: 100
        }
        alwaysUnlocked: true
    }
    {
        name: httr-cogeneration
        localizedName: "Energy and hydrogen"
        craftTime: 60
        input: {
            items: ["thorium/1", "graphite/1"]
            liquids: ["helium/0.666667", "water/3.333333"]
            power: 5
        }
        output: {
            liquids: ["slag/0.166667", "hydrogen/2", "ozone/1.333333"]
            power: 83.333333
        }
        alwaysUnlocked: true
    }
]

# Кинетический сплав (surge-alloy) - в обшивке реактора, отсюда и жёлтая окантовка на текстуре.
# Время строительства игра считает сама: сумма (количество x цена предмета) в тиках, здесь около 55 с.
requirements: ["beryllium/650", "tungsten/500", "silicon/550", "graphite/400", "carbide/300", "oxide/250", "surge-alloy/180"]
category: "power"
buildVisibility: "shown"

research: {
    parent: beryllium-decay-chamber
    requirements: ["beryllium/2000", "tungsten/1500", "silicon/1650", "graphite/1200", "carbide/900", "oxide/750", "surge-alloy/550"]
}

# Отрисовка: основа (sprites/blocks/electro/httr.png) и отдельный слой свечения (httr-glow.png).
# Свечение накладывается сложением цветов, видно только во время работы и плавно пульсирует.
# color ffffff - свечение берёт цвета из самой текстуры (по умолчанию игра красит его в красный).
# glowIntensity - глубина пульсации (0 = без пульсации), glowScale - её медленность.
drawer: {
    type: DrawMulti
    drawers: [
        {
            type: DrawDefault
        }
        {
            type: DrawGlowRegion
            suffix: "-glow"
            color: "ffffff"
            alpha: 1
            glowScale: 12
            glowIntensity: 0.3
        }
    ]
}
